{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "nostopit hook"}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "nostopit hook"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "nostopit hook"}]
      }
    ]
  }
}
